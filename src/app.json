{
  "expo": {
    "name": "Manganitor",
    "slug": "manganitor",
    "version": "0.2.5",
    "orientation": "portrait",
    "icon": "./assets/app/icon.png",
    "scheme": "src",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/app/icon.png",
      "bundleIdentifier": "com.iut.manganitor"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1033",
        "foregroundImage": "./assets/app/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.iut.manganitor"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73c6c84b-79b1-4592-a101-14eeb2acb26d"
      }
    }
  }
}
